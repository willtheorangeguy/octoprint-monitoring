            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Job Timing",
      "description": "Timing gauges exist only while the plugin emits active-job data.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(octoprint_print_time_elapsed{job=\"${job_octoprint}\",instance=\"$instance\"})",
          "legendFormat": "Elapsed",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
        },
        {
          "refId": "B",
          "expr": "max(octoprint_print_time_left_estimate{job=\"${job_octoprint}\",instance=\"$instance\"})",
          "legendFormat": "Estimated left",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Started Since Restart",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "octoprint_started_prints_total{job=\"${job_octoprint}\",instance=\"$instance\"}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not reported"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Completed Since Restart",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "octoprint_done_prints_total{job=\"${job_octoprint}\",instance=\"$instance\"}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not reported"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Failed Since Restart",
      "description": "Plugin counter since OctoPrint restart.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "octoprint_failed_prints_total{job=\"${job_octoprint}\",instance=\"$instance\"}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not reported",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
