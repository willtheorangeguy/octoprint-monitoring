    {
      "id": 15,
      "type": "stat",
      "title": "Completed Print Time",
      "description": "Accumulated completed-print runtime since OctoPrint restart; not the current job's elapsed time.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
