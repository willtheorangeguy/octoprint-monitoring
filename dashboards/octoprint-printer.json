    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Commanded Print Fan",
      "description": "Derived from M106/M107 S values (0â€“255); this is commanded PWM, not measured fan RPM.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * octoprint_print_fan_speed{job=\"${job_octoprint}\",instance=\"$instance\"} / 255",
          "legendFormat": "G-code fan command",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          }
